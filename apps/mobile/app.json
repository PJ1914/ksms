{
  "expo": {
    "name": "KSMS",
    "slug": "ksms",
    "version": "0.1.0",
    "scheme": "ksms",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "KSMS uses the camera only to scan product barcodes."
        }
      ],
      "expo-sqlite"
    ],
    "android": {
      "package": "com.ksms.storemanager"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
