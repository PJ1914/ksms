# Copy to .env and fill in. NEVER commit .env. Values below are placeholders only.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Neon POOLED url (host contains "-pooler") — used by the running API.
DATABASE_URL='postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full'
# Neon DIRECT url (no "-pooler") — used ONLY by Prisma migrations / CI deploy job.
DIRECT_URL='postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=verify-full'

# Secret used to sign access tokens (min 32 chars). Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900

# Rate limiting (per IP): requests per window
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000

# Optional: comma-separated browser origins allowed by CORS (not needed for the native app)
CORS_ORIGINS=
# Swagger UI at /api/docs. Defaults to on, except in production.
# SWAGGER_ENABLED=true

# Stricter per-IP limit for login/register/refresh/accept-invitation (requests per minute)
AUTH_THROTTLE_LIMIT=10
# Refresh token lifetime (sliding), in days
REFRESH_TTL_DAYS=30
# Absolute session lifetime from sign-in, in days (>= REFRESH_TTL_DAYS); after it the user signs in again
SESSION_ABSOLUTE_TTL_DAYS=90

# Database connection pool, per API instance (see docs/architecture/DEPLOYMENT.md "Connection pool").
# Keep DB_POOL_MAX x number of instances below the Neon pooler's connection limit.
DB_POOL_MAX=5
DB_POOL_IDLE_MS=10000
DB_POOL_CONNECT_TIMEOUT_MS=10000
